<%-include('../partials/header',{title:'Entry Baru'})%><h1>Entry Baru</h1><form method=post action=/entries class=card><label>Manifest<select name=manifest_id required><option value="">Pilih</option><%manifests.forEach(m=>{%><option value=<%=m.id%>><%=m.no_manifest%></option><%})%></select></label><label>Invoice<select name=invoice_id required><option value="">Pilih</option><%invoices.forEach(i=>{%><option value=<%=i.id%>><%=i.invoice_no%> — <%=i.customer_name%></option><%})%></select></label><label>Catatan<textarea name=notes></textarea></label><button class="btn primary">Simpan</button></form><%-include('../partials/footer')%>