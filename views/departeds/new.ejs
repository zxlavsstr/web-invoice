<%-include('../partials/header',{title:'Departed Baru'})%><h1>Departed Baru</h1><form method=post action=/departeds class=card><label>Manifest<select id=manifest name=manifest_id required><option value="">Pilih</option><%manifests.forEach(m=>{%><option value=<%=m.id%>><%=m.no_manifest%></option><%})%></select></label><label>Tanggal<input type=date name=departed_date value="<%=new Date().toISOString().slice(0,10)%>" required></label><div id=list>Pilih manifest.</div><input type=hidden name=manifest_invoice_ids id=ids><label>Keterangan<textarea name=keterangan></textarea></label><button class="btn primary">Simpan</button></form><script>manifest.onchange=async()=>{let r=await fetch('/api/manifests/'+manifest.value+'/invoices').then(x=>x.json());list.innerHTML=r.map(x=>'<label><input type=checkbox value='+x.id+'> '+x.invoice_no+' — '+x.customer_name+'</label>').join('')||'Tidak ada invoice.'};document.querySelector('form').onsubmit=()=>ids.value=[...list.querySelectorAll('input:checked')].map(x=>x.value).join(',')</script><%-include('../partials/footer')%>