<%- include('../partials/header',{title:'Departed'}) %>
<h1>Departed</h1>
<a class="btn primary" href="/departeds/new">+ Departed</a>
<div class="card"><table><thead><tr><th>Manifest</th><th>Tanggal</th><th>Keterangan</th></tr></thead><tbody>
<% departeds.forEach(d=>{ %><tr><td><%= d.no_manifest %></td><td><%= d.departed_date %></td><td><%= d.keterangan || '-' %></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/footer') %>