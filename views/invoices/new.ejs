<%- include('../partials/header', {title: 'Buat Invoice'}) %>
<div class="page-head"><h1>Buat Invoice</h1><a class="btn" href="/invoices">Kembali</a></div>
<form class="card form" method="post" action="/invoices">
<div class="grid two">
<label>No. Invoice<input name="invoice_no" required placeholder="INV-2026-001"></label>
<label>Pelanggan<select name="customer_id" required><option value="">Pilih pelanggan</option><% customers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label>
<label>Tanggal<input type="date" name="invoice_date" value="<%= new Date().toISOString().slice(0,10) %>" required></label>
<label>Jatuh Tempo<input type="date" name="due_date"></label>
<label>PPN (%)<input type="number" name="tax_rate" value="0" min="0" step="0.01"></label>
<label>Mata Uang<select name="currency"><option>IDR</option><option>USD</option></select></label>
</div>
<label>Catatan<textarea name="notes" rows="3"></textarea></label>
<label>Items (JSON)<textarea name="items" rows="8" required>[{"description":"Jasa","qty":1,"unit_price":0}]</textarea></label>
<p class="muted">Format item: description, qty, unit_price. Bisa ditambah beberapa item sebagai array JSON.</p>
<button class="btn primary">Simpan Invoice</button>
</form>
<%- include('../partials/footer') %>