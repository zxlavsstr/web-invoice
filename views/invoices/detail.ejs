<%- include('../partials/header', {title: 'Detail Invoice'}) %>
<div class="page-head"><div><h1><%= invoice.invoice_no %></h1><p class="muted"><%= invoice.invoice_date %></p></div><button class="btn" onclick="window.print()">Cetak</button></div>
<div class="card invoice"><div class="grid two"><div><strong>Pelanggan</strong><p><%= invoice.customer_name %><br><%= invoice.customer_address || '' %><br><%= invoice.customer_phone || '' %></p></div><div><strong>Jatuh Tempo</strong><p><%= invoice.due_date || '-' %></p></div></div>
<table><thead><tr><th>Deskripsi</th><th>Qty</th><th>Harga</th><th>Total</th></tr></thead><tbody><% items.forEach(x => { %><tr><td><%= x.description %></td><td><%= x.qty %></td><td><%= Number(x.unit_price).toLocaleString('id-ID') %></td><td><%= Number(x.line_total).toLocaleString('id-ID') %></td></tr><% }) %></tbody></table>
<div class="summary"><div>Subtotal <strong><%= totals.subtotal.toLocaleString('id-ID') %></strong></div><div>PPN (<%= invoice.tax_rate %>%) <strong><%= totals.tax.toLocaleString('id-ID') %></strong></div><div class="grand">Total <strong><%= totals.total.toLocaleString('id-ID') %></strong></div></div></div><%- include('../partials/footer') %>