<%-include('../partials/header',{title:'Detail Invoice'})%><div class="head"><h1>Invoice <%=invoice.invoice_no%></h1><button class="btn" onclick="print()">Cetak</button></div><section class="card"><p><b>Pelanggan:</b> <%=invoice.customer_name%></p><table><tr><th>Deskripsi</th><th>Qty</th><th>Harga</th><th>Total</th></tr><%items.forEach(i=>{%><tr><td><%=i.description%></td><td><%=i.qty%></td><td><%=i.unit_price.toLocaleString('id-ID')%></td><td><%=i.line_total.toLocaleString('id-ID')%></td></tr><%})%></table><div class=totals>Subtotal <b><%=totals.subtotal.toLocaleString('id-ID')%></b><br>PPN <b><%=totals.tax.toLocaleString('id-ID')%></b><hr>Total <b><%=totals.total.toLocaleString('id-ID')%></b></div></section><%-include('../partials/footer')%>